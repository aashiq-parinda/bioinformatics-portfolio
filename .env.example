# NCBI Entrez API Configuration (Required for polite NCBI rate limits: 10 req/s vs 3 req/s)
NCBI_EMAIL=engineer@example.com
NCBI_API_KEY=

# UniProt API Configuration
UNIPROT_CONTACT=engineer@example.com

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Data & Output Directories
BIO_DATA_DIR=./data
BIO_RESULTS_DIR=./results

# Compute / Threading Configuration
BIO_NUM_THREADS=4
RANDOM_SEED=42
